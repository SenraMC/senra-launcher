        <div id="loadingContent">
            <div id="loadSpinnerContainer">
                <img id="loadCenterImage" src="assets/images/senra/logo.png" alt="">
                <span id="loadSpinnerImage" class="rotating"></span>
            </div>
        </div>
    </div>
