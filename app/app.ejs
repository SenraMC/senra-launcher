    <link type="text/css" rel="stylesheet" href="./assets/css/launcher.css">
    <style>
        body {
            -webkit-user-select: none;
        }
        #main {
            display: none;
        }
        #main[overlay] {
            filter: blur(3px) contrast(0.9) brightness(1.0);
        }
    </style>
    <link type="text/css" rel="stylesheet" href="./assets/css/senra.css">
</head>
<body data-vue="chargement">
